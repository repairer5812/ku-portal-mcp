FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY ku_portal_mcp ./ku_portal_mcp
COPY remote_entrypoint.py ./remote_entrypoint.py

RUN pip install --no-cache-dir . \
    && groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home app \
    && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["python", "remote_entrypoint.py"]
